# SteamOS @POLARIS_STEAMOS_TARGET@ package template. Generated by CMake from an exact Polaris commit.
: "${_run_unit_tests:=true}"
: "${_commit:=@GITHUB_COMMIT@}"

# See the Arch PKGBUILD for why the DRM/KMS helper is its own package. 'polaris' stays first: a
# bare $pkgname is the array's first element, and the sources are named after it.
pkgbase=polaris
pkgname=('polaris' 'polaris-kms')
pkgver=@PROJECT_VERSION@@POLARIS_SUB_VERSION@
pkgrel=1
pkgdesc="@PROJECT_DESCRIPTION@"
arch=('x86_64')
url=@PROJECT_HOMEPAGE_URL@
license=('GPL-3.0-only')
install=polaris.install

# Split a polaris-debug package so crash reports from this build are debuggable.
# The build isolates volk's pointer globals and the generated scaler shader type,
# so makepkg's default LTO can remain enabled.
options=('debug' 'strip')

# labwc is deliberately absent. Polaris links nothing from it, and on SteamOS 3.8 it
# resolves to labwc 0.9.0 -> wlroots0.19 -> libdisplay-info.so=2, which downgrades the
# libdisplay-info 0.3.0 that holo-3.8.1x ships and KWin, Mesa, and Vulkan link against.
# It is an optdepend instead; see docs/steamos.md. Not yet tried on SteamOS 3.9.
#
# The libboost_*.so entries bind the package to the Boost release it was built against. Boost
# renames its libraries with every release and each SteamOS release ships one, so boost-libs alone
# lets a package install on a SteamOS whose Boost it cannot load. makepkg turns each entry into an
# exact soname dependency, libboost_locale.so=1.88.0-64 for a 3.8 build, which only that
# release's boost-libs provides. build-steamos-package.sh checks every Boost library the binary
# needs is bound this way.
depends=(
  'avahi'
  'bash'
  'boost-libs'
  'curl'
  @POLARIS_STEAMOS_RUNTIME_DEPENDS@
  'glib2'
  'glibc'
  'grim'
  'gtk3'
  'hicolor-icon-theme'
  'libayatana-appindicator'
  'libboost_filesystem.so'
  'libboost_locale.so'
  'libboost_log.so'
  'libboost_program_options.so'
  'libboost_thread.so'
  'libcap'
  'libdrm'
  'libei'
  'libevdev'
  'libmfx'
  'libnotify'
  'libpulse'
  'libva'
  'libpipewire'
  'libx11'
  'libxcb'
  'libxfixes'
  'libxi'
  'libxkbcommon'
  'libxrandr'
  'libxtst'
  'mesa'
  'miniupnpc'
  'numactl'
  'openssl'
  'opus'
  'pipewire'
  'python'
  'udev'
  'vulkan-icd-loader'
  'wayland'
  'which'
  'wlr-randr'
  'xorg-xdpyinfo'
  'xorg-xwayland'
)

makedepends=(
  'appstream'
  'appstream-glib'
  'cmake'
  'desktop-file-utils'
  'gcc'
  'git'
  'go'
  'make'
  'ninja'
  'nlohmann-json'
  'nodejs'
  'npm'
  'shaderc'
  'vulkan-headers'
)

optdepends=(
  '@POLARIS_STEAMOS_LABWC_OPTDEPEND@'
  'libva-mesa-driver: AMD GPU encoding support'
)

source=("$pkgname::git+@GITHUB_CLONE_URL@#commit=${_commit}")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname"
  git submodule update --recursive --init
}

build() {
  export BRANCH="@GITHUB_BRANCH@"
  export BUILD_VERSION="@BUILD_VERSION@"
  # Without it the package would be named for the prerelease and the binary would report the release.
  export POLARIS_PRERELEASE_LABEL="@POLARIS_PRERELEASE_LABEL@"
  export COMMIT="${_commit}"
  export CC="${CC:-gcc}"
  export CXX="${CXX:-g++}"
  export CFLAGS="${CFLAGS/-Werror=format-security/}"
  export CXXFLAGS="${CXXFLAGS/-Werror=format-security/}"

  # Match the GNU-only Release workaround without aging out on compiler bumps.
  # Clang defines __GNUC__ for compatibility but does not use the workaround.
  local _compiler_macros
  _compiler_macros="$("${CXX}" -dM -E -x c++ /dev/null)"
  if [[ "${_compiler_macros}" == *"#define __GNUC__ "* &&
        "${_compiler_macros}" != *"#define __clang__ "* ]]; then
    local _filtered_cppflags=()
    local _filtered_cflags=()
    local _filtered_cxxflags=()
    local _flag

    read -r -a _cppflags_array <<< "${CPPFLAGS}"
    for _flag in "${_cppflags_array[@]}"; do
      case "${_flag}" in
        -D_FORTIFY_SOURCE=*|-Wp,-D_FORTIFY_SOURCE=*) ;;
        *) _filtered_cppflags+=("${_flag}") ;;
      esac
    done
    read -r -a _cflags_array <<< "${CFLAGS}"
    for _flag in "${_cflags_array[@]}"; do
      case "${_flag}" in
        -D_FORTIFY_SOURCE=*|-Wp,-D_FORTIFY_SOURCE=*) ;;
        *) _filtered_cflags+=("${_flag}") ;;
      esac
    done
    read -r -a _cxxflags_array <<< "${CXXFLAGS}"
    for _flag in "${_cxxflags_array[@]}"; do
      case "${_flag}" in
        -D_FORTIFY_SOURCE=*|-Wp,-D_FORTIFY_SOURCE=*) ;;
        *) _filtered_cxxflags+=("${_flag}") ;;
      esac
    done
    export CPPFLAGS="${_filtered_cppflags[*]}"
    export CFLAGS="${_filtered_cflags[*]}"
    export CXXFLAGS="${_filtered_cxxflags[*]}"
  fi

  cmake -S "$pkgname" -B build -G Ninja -Wno-dev \
    -D BUILD_DOCS=OFF \
    -D BUILD_TESTS=ON \
    -D BUILD_WERROR=ON \
    -D BOOST_USE_STATIC=OFF \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -D CUDA_FAIL_ON_MISSING=OFF \
    -D POLARIS_ALLOW_CUDA_DISABLED_ON_NVIDIA=ON \
    -D POLARIS_ASSETS_DIR=share/polaris \
    -D POLARIS_ENABLE_BROWSER_STREAM=ON \
    -DPOLARIS_ENABLE_CUDA=OFF \
    -D POLARIS_EXECUTABLE_PATH=/usr/bin/polaris
  cmake --build build --parallel "$(nproc)"
}

check() {
  cd "$srcdir/build"
  ./polaris --version
  if [[ "${_run_unit_tests::1}" == "t" ]]; then
    # The multiseat Go suite drives real PipeWire and D-Bus children and checks
    # filesystem identity on a live host. Inside the package build container it
    # fails for environmental reasons, so only the C++ suites run here.
    ctest --test-dir tests --output-on-failure -E '^polaris_multiseat_worker_go$'
  fi
}

package_polaris() {
  install=polaris.install
  cd "$srcdir"
  DESTDIR="$pkgdir" cmake --install build --component polaris
  python "$srcdir/$pkgname/scripts/spaces/verify_package.py" "$pkgdir"
  # The binary is named for the release number alone. A prerelease's pkgver carries its label too.
  test -x "$pkgdir/usr/bin/polaris-@PROJECT_VERSION@"
  test "$(readlink "$pkgdir/usr/bin/polaris")" = "polaris-@PROJECT_VERSION@"
  test -f "$pkgdir/usr/lib/udev/rules.d/60-polaris.rules"
  test -f "$pkgdir/usr/lib/modules-load.d/60-polaris.conf"
  test -x "$pkgdir/usr/bin/polaris-gamescope-session"
  test -x "$pkgdir/usr/bin/polaris-gamescope-runtime-lib.sh"
  bash -n "$pkgdir/usr/bin/polaris-gamescope-session"
  bash -n "$pkgdir/usr/bin/polaris-gamescope-runtime-lib.sh"
  test ! -e "$pkgdir/usr/libexec/polaris/polaris-kms"
}

package_polaris-kms() {
  pkgdesc="DRM/KMS capture helper for Polaris"
  depends=("polaris=$pkgver-$pkgrel")
  install=polaris-kms.install

  cd "$srcdir"
  DESTDIR="$pkgdir" cmake --install build --component kms

  test -f "$pkgdir/usr/libexec/polaris/polaris-kms"
  test -f "$pkgdir/usr/lib/sysusers.d/polaris-kms.conf"
  test ! -e "$pkgdir/usr/bin/polaris"
}
